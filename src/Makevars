PKG_CFLAGS = -pthread
PKG_LIBS = -pthread
OBJECTS = bounded.o channel.o entity.o init.o liveness.o payload.o pool.o \
          preamble.o shm_rw.o wait_linux.o wait_macos.o wait_win32.o wrap.o \
          vendor/serialize.o vendor/shm.o

.PHONY: all clean

all: $(SHLIB)

# R's makefiles track no header dependencies: without this, editing a header
# recompiles nothing and one mov.so links objects built from two headers.
$(OBJECTS): mov.h vendor/mori.h

clean:
	@rm -f $(OBJECTS) $(SHLIB)
