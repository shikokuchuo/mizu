PKG_CFLAGS = -pthread
PKG_LIBS = -pthread
OBJECTS = bounded.o channel.o condition.o entity.o init.o liveness.o map.o \
          payload.o pool.o preamble.o rng.o shm_rw.o tune.o wait_linux.o \
          wait_macos.o wait_win32.o wrap.o zc.o vendor/altrep.o \
          vendor/serialize.o vendor/shm.o

.PHONY: all clean

all: $(SHLIB)

# R's makefiles track no header dependencies: without this, editing a header
# recompiles nothing and one kioto.so links objects built from two headers.
$(OBJECTS): kioto.h vendor/mori.h

clean:
	@rm -f $(OBJECTS) $(SHLIB)
